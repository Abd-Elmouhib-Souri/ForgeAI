# ForgeAI : modèle de configuration
#
# Ne remplissez pas ce fichier à la main : lancez  python scripts/init_env.py
# Il crée .env (et backend/.env, frontend/.env.local) avec tous les secrets
# internes générés au hasard. Il ne reste alors QUE les clés d'API externes
# (section « Clés à fournir ») à coller dans .env.
# Ne committez jamais .env : il est ignoré par git.

# ─── Application ──────────────────────────────────────────────
APP_NAME=ForgeAI
ENVIRONMENT=development
DEBUG=True
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=["http://localhost:3000"]
# Port de l'API admin sur la machine (127.0.0.1 uniquement). Changez-le si 8002 est pris.
ADMIN_API_PORT=8002

# ─── Secrets internes (générés par scripts/init_env.py) ───────
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Clé Fernet (32 octets en base64) : chiffre les secrets 2FA des admins.
AES_SECRET_KEY=
SESSION_SECRET_KEY=

# ─── PostgreSQL (conteneur « postgres ») ──────────────────────
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=forgeai
POSTGRES_USER=forgeai_user
POSTGRES_PASSWORD=
# Construit par scripts/init_env.py avec le mot de passe ci-dessus.
DATABASE_URL=

# ─── Redis et ChromaDB (conteneurs) ───────────────────────────
REDIS_URL=redis://redis:6379/0
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_AUTH_TOKEN=
ANONYMIZED_TELEMETRY=FALSE
CHROMA_ANONYMIZED_TELEMETRY=false

# ─── Clés à fournir ───────────────────────────────────────────
# Au moins UNE clé d'IA est nécessaire pour lancer une analyse (les deux = relais en cas de quota).
#   Gemini : https://aistudio.google.com/apikey (gratuit)
#   Groq   : https://console.groq.com/keys     (gratuit)
GEMINI_API_KEY=
GROQ_API_KEY=
# Recherche web des sources (recommandée) : https://app.tavily.com
# Sans clé, la recherche passe automatiquement par DuckDuckGo (moins de sources).
TAVILY_API_KEY=
# Facultatif : classement des sources par Gemini. Vide = le classement passe par Groq.
# Vous pouvez y mettre la même clé que GEMINI_API_KEY.
GEMINI_SEARCH_CLASSIFIER_API_KEY=
# Facultatif (bouton « Continuer avec Google ») : https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Facultatif : sans SMTP (en développement), les e-mails de vérification et de
# mot de passe oublié sont écrits dans  docker compose logs backend  avec leur lien.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ForgeAI
# Inutilisé aujourd'hui.
OPENAI_API_KEY=

# ─── Modèles d'IA (vérifiés par la page « Santé du système ») ─
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=groq
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_SEARCH_MODEL=gemini-3-flash-preview
GEMINI_SEARCH_CLASSIFIER_MODEL=gemini-3-flash-preview
GROQ_API_BASE=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
LLM_REQUEST_TIMEOUT_SECONDS=90
LLM_CIRCUIT_FAILURES=3
LLM_CIRCUIT_COOLDOWN_SECONDS=180
ENABLE_PARALLEL_AGENTS=false
ENABLE_DETERMINISTIC_FALLBACK=true

# ─── Analyses ─────────────────────────────────────────────────
ANALYSIS_MAX_CONCURRENT_RUNS=2
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=1

# ─── Recherche de sources ─────────────────────────────────────
ENABLE_TAVILY_SEARCH=true
ENABLE_DDGS_FALLBACK=true
ENABLE_GEMINI_GROUNDED_SEARCH=false
ENABLE_AI_SOURCE_CLASSIFIER=true
SEARCH_MODE=tavily
SEARCH_PRIMARY_PROVIDER=tavily
SEARCH_FALLBACK_PROVIDER=ddgs
SEARCH_MAX_QUERIES_PER_ANALYSIS=10
SEARCH_MAX_RESULTS_PER_QUERY=8
SEARCH_MIN_RESULTS=4
SEARCH_PROVIDER_TIMEOUT_SECONDS=35
SEARCH_CACHE_TTL_SECONDS=21600
SEARCH_CIRCUIT_FAILURES=2
SEARCH_CIRCUIT_COOLDOWN_SECONDS=900
SEARCH_CLASSIFIER_PRIMARY=gemini
SEARCH_CLASSIFIER_FALLBACK=groq
SEARCH_CLASSIFIER_TIMEOUT_SECONDS=35
SEARCH_CLASSIFIER_MAX_SOURCES=16
TAVILY_SEARCH_URL=https://api.tavily.com/search
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=8
TAVILY_MIN_SCORE=0.35
TAVILY_CHUNKS_PER_SOURCE=2
TAVILY_INCLUDE_RAW_CONTENT=false
TAVILY_SAFE_SEARCH=false
TAVILY_MAX_CONCURRENT_REQUESTS=3

# ─── Diagrammes (rendu UML / architecture) ────────────────────
KROKI_ENABLED=true
KROKI_BASE_URL=https://kroki.io

# ─── Divers ───────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000
LANG=en_US.UTF-8
LC_ALL=C.UTF-8
PYTHONIOENCODING=utf-8
PYTHONUTF8=1
